# Copy to .env for local development (never commit .env)
APP_NAME=chatbot
LOG_LEVEL=DEBUG

# Leave MYSQL_HOST empty to use a local SQLite file
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=chatbot
MYSQL_USER=chatbot
MYSQL_PASSWORD=

# Gemini (secret key: never commit a real value)
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it
